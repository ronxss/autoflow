<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoFlow.Mobile.Pages.ContaPage"
             Title="Minha conta">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Border Style="{StaticResource Cartao}">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Nome}" Style="{StaticResource Titulo}" />
                <Label Text="{Binding Email}" />
                <Label Text="{Binding TipoDeConta}" Style="{StaticResource Suave}" />
            </VerticalStackLayout>
        </Border>
        <Label Text="O app pede o PIN ou a biometria do aparelho sempre que é aberto."
               Style="{StaticResource Suave}" />
        <Button Text="Sair da conta" Style="{StaticResource BotaoSecundario}" Command="{Binding SairCommand}" />
        <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" />
    </VerticalStackLayout>
</ContentPage>
