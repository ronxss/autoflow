<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AutoFlow.Mobile.ViewModels"
             x:Class="AutoFlow.Mobile.Pages.BuscaPage"
             Title="Buscar profissionais">
    <Grid RowDefinitions="Auto,*" Padding="16,8" RowSpacing="8">

        <VerticalStackLayout Spacing="6">
            <SearchBar Placeholder="Serviço ou nome do profissional" Text="{Binding Termo}"
                       SearchCommand="{Binding BuscarCommand}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Picker Title="Área de atuação" ItemsSource="{Binding Areas}" SelectedItem="{Binding AreaSelecionada}" />
                <Picker Grid.Column="1" Title="Ordenar por" ItemsSource="{Binding Ordenacoes}"
                        SelectedIndex="{Binding IndiceOrdenacao}" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Picker Title="Avaliação" ItemsSource="{Binding Avaliacoes}" SelectedIndex="{Binding IndiceAvaliacao}" />
                <Entry Grid.Column="1" Placeholder="Preço máx./hora (R$)" Keyboard="Numeric"
                       Text="{Binding PrecoMaximo}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="Só perto de mim (até 25 km)" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding PertoDeMim}" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="Buscar" Command="{Binding BuscarCommand}" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Resultados}"
                        EmptyView="Nenhum profissional encontrado com esses filtros.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,5">
                        <Border Style="{StaticResource Cartao}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BuscaViewModel}}, Path=AbrirCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="8">
                                <Label Text="{Binding Nome}" Style="{StaticResource Subtitulo}" />
                                <Label Grid.Column="1" Text="{Binding AvaliacaoMedia, StringFormat='★ {0:N1}'}"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="1" Text="{Binding AreaAtuacao}" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding PrecoBaseHora, StringFormat='R$ {0:N2}/h'}" />
                                <Label Grid.Row="2" Text="{Binding Cidade}" Style="{StaticResource Suave}" />
                                <Label Grid.Row="2" Grid.Column="1" Style="{StaticResource Suave}"
                                       Text="{Binding DistanciaKm, StringFormat='{0:N1} km', TargetNullValue=''}" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}"
                           VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
