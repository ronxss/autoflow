<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AutoFlow.Mobile.ViewModels"
             x:Class="AutoFlow.Mobile.Pages.SolicitacoesPage"
             Title="Pedidos">
    <RefreshView IsRefreshing="{Binding Atualizando}" Command="{Binding CarregarCommand}">
        <CollectionView ItemsSource="{Binding Itens}" Margin="16,8"
                        EmptyView="Você ainda não tem pedidos. Puxe para baixo para atualizar.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,5">
                        <Border Style="{StaticResource Cartao}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SolicitacoesViewModel}}, Path=AbrirCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2"
                                  ColumnSpacing="8">
                                <Label Text="{Binding Servico}" Style="{StaticResource Subtitulo}" />
                                <Label Grid.Column="1" Text="{Binding Situacao}" TextColor="{Binding CorSituacao}"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="1" Text="{Binding OutraPessoa}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Preco}" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Quando}"
                                       Style="{StaticResource Suave}" />
                                <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Observacoes}"
                                       IsVisible="{Binding TemObservacoes}" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
